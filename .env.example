# 大模型默认配置（可选）。推荐启动后在网页「设置」页选择供应商并填写 Key，
# 配置会保存在本地数据库、无需改动本文件。
# 说明：这里的 DEEPSEEK_* 仅在供应商为 DeepSeek（默认）时作为回退默认值；
#       切换到 OpenAI / 通义千问 / 自定义时，请在设置页填写该供应商的 Key 与模型。
# 任何位置都没有 Key 时使用 mock 评估（规则启发式，不调用大模型）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库文件路径（默认项目根目录 interview.db）
# 首次启动会自动建库，并通过 Alembic 自动升级到最新结构。
DATABASE_URL=sqlite:///./interview.db

# 强制使用 mock 评估器（true/false）：设为 true 时即使配置了 Key 也不调用大模型，
# 便于离线体验与运行测试。
USE_MOCK_EVALUATOR=false

# 用于加密数据库中保存的 API Key（可选）。留空时会自动生成项目根目录的
# .secret_key 文件并复用；删除或更换后需要重新填写 Key。
# APP_SECRET_KEY=
